diff --git a/framework/platform/bpl/cfg/linux/bpl_cfg_ifaces.cpp.in b/framework/platform/bpl/cfg/linux/bpl_cfg_ifaces.cpp.in
index 2653570..1eac659 100644
--- a/framework/platform/bpl/cfg/linux/bpl_cfg_ifaces.cpp.in
+++ b/framework/platform/bpl/cfg/linux/bpl_cfg_ifaces.cpp.in
@@ -9,0 +10,2 @@
+#include <cctype>
+#include <net/if.h>
@@ -11,0 +14,2 @@
+#include "bpl_cfg_linux.h"
+
@@ -30,0 +35,15 @@ bool radio_num_to_wlan_iface_name(const int32_t radio_num, std::string &iface_st
+    if (radio_num < 0 || radio_num > 3) {
+        return false;
+    }
+    const std::string key = "wireless_interface_" + std::to_string(radio_num);
+    if (cfg_get_param(key, iface_str)) {
+        if (iface_str.empty() || iface_str.size() >= IFNAMSIZ) {
+            return false;
+        }
+        for (const unsigned char ch : iface_str) {
+            if (!std::isalnum(ch) && ch != '_' && ch != '-' && ch != '.') {
+                return false;
+            }
+        }
+        return true;
+    }
