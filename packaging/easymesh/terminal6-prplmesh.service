[Unit]
Description=Terminal 6 prplMesh Multi-AP Controller/Agent
Documentation=file:/usr/share/doc/terminal6-easymesh/STATUS-20261115.ja.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/terminal6-easymesh/enabled
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=root
ExecStartPre=/usr/libexec/terminal6-easymesh-preflight --for-start
ExecStart=/usr/libexec/terminal6-easymesh-supervisor
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
RuntimeDirectory=terminal6-easymesh
RuntimeDirectoryMode=0700
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_PACKET AF_NETLINK

[Install]
WantedBy=multi-user.target
