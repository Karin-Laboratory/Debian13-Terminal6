set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

if(NOT DEFINED ENV{CUNIT_TARGET_SYSROOT} OR "$ENV{CUNIT_TARGET_SYSROOT}" STREQUAL "")
    message(FATAL_ERROR "Set CUNIT_TARGET_SYSROOT to the Debian 13 arm64 sysroot")
endif()
set(_target_sysroot "$ENV{CUNIT_TARGET_SYSROOT}")
if(NOT IS_DIRECTORY "${_target_sysroot}")
    message(FATAL_ERROR "CUNIT_TARGET_SYSROOT is not a directory: ${_target_sysroot}")
endif()

set(CMAKE_SYSROOT "${_target_sysroot}")
set(CMAKE_C_COMPILER aarch64-linux-gnu-gcc)
set(CMAKE_CXX_COMPILER aarch64-linux-gnu-g++)
set(CMAKE_FIND_ROOT_PATH "${_target_sysroot}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
